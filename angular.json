{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "packageManager": "npm" },
  "newProjectRoot": "projects",
  "projects": {
    "zitadel-pgrst-angular": {
      "projectType": "library",
      "root": "projects/zitadel-pgrst-angular",
      "sourceRoot": "projects/zitadel-pgrst-angular",
      "prefix": "base",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/zitadel-pgrst-angular/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/zitadel-pgrst-angular/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/zitadel-pgrst-angular/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
