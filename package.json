{
  "name": "zitadel-pgrst-angular-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "ng-packagr workspace for @heimvio/zitadel-pgrst-angular (Zitadel + PostgREST + RLS building blocks: auth + provisioning).",
  "workspaces": [
    "examples/products/web"
  ],
  "scripts": {
    "build:lib": "ng build zitadel-pgrst-angular",
    "pack:lib": "cd dist/zitadel-pgrst-angular && npm pack",
    "publish:lib": "cd dist/zitadel-pgrst-angular && npm publish",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "packageManager": "npm@10.9.4",
  "devDependencies": {
    "@angular/build": "^21.1.1",
    "@angular/cli": "^21.1.1",
    "@angular/compiler-cli": "^21.1.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "ng-packagr": "^21.1.0",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/router": "^21.1.0",
    "angular-oauth2-oidc": "^20.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  }
}
