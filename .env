# Reproduzierbare Defaults für `docker compose up`. Für eine Demo ok –
# in echt natürlich Secrets ersetzen.
POSTGRES_PASSWORD=postgres
AUTHENTICATOR_PASSWORD=authpw
POSTGRES_PORT=55433

ZITADEL_VERSION=latest
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
ZITADEL_ADMIN_PASSWORD=Admin1!Demo
ZITADEL_PORT=8090

POSTGREST_PORT=3001
LOGIN_PORT=8089
